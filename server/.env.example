# ============================================================================
# SERVER CONFIGURATION
# (On Render, remove surrounding quotes when pasting values into the dashboard)
# ============================================================================
PORT=
HOST=
# Must be exactly: development | production | test
NODE_ENV=

# ============================================================================
# CORS & PROXY
# ============================================================================
# Comma-separated list of allowed frontend origins
CLIENT_URL=
# Whole number 0 or more (0 for direct connection, 1 for Render single proxy)
TRUSTED_PROXY_HOPS=

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
DATABASE_URL=
# Must be exactly: off | verify | no-verify
DATABASE_SSL=
# Optional: only used when DATABASE_SSL=verify (leave empty otherwise)
DATABASE_CA_CERT=

# ============================================================================
# CLOUDINARY
# ============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Must be exactly: true | false
CLOUDINARY_CLEANUP_DRY_RUN=

# ============================================================================
# SINGLE-OWNER AUTH & SECURITY
# ============================================================================
# Whole number 1 or more (days before session expires)
SESSION_EXPIRY_DAYS=
# Consecutive failed login attempts before IP lockout
LOGIN_FAIL_LIMIT=
# Duration of IP lockout in minutes
LOGIN_LOCK_MINUTES=
