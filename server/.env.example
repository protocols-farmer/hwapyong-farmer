# On Render remove quotes " "

# --- Server Configuration (don't set PORT on Render) ---
PORT=5000
HOST=0.0.0.0
NODE_ENV="development"

# --- CORS & Proxy ---
CLIENT_URL="http://localhost:3000,https://your-frontend.vercel.app"
# 0 for local direct connection, set to 1 on Render
TRUSTED_PROXY_HOPS=1

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Must be exactly: off | verify | no-verify
DATABASE_SSL="off"
DATABASE_CA_CERT=""

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_CLEANUP_DRY_RUN="true"

# --- Single-Owner Auth & Security ---
SESSION_EXPIRY_DAYS=30
LOGIN_FAIL_LIMIT=5
LOGIN_LOCK_MINUTES=15
